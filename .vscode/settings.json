{
  // Prettier
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  // Shopify Liquid
  "files.associations": {
    "*.html": "liquid"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  // Formatter
  "[html][liquid]": {
    "editor.defaultFormatter": "Shopify.theme-check-vscode"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  // Disable vscode built-in stylelint
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  // Stylint extension settings
  "stylelint.snippet": ["css", "scss"],
  "stylelint.validate": ["css", "scss"],
  // Run tasks in macOS
  "terminal.integrated.profiles.osx": {
    "zsh": { "path": "/bin/zsh", "args": ["-l", "-i"] }
  },
  "jekll.autocomplete.gemini.api": "",
  "jekll.autocomplete.commands": {
    "new blank": {
      "sort": "900",
      "desc": "new blank, 강제 빈칸 입력",
      "insert": "&nbsp;"
    },
    "new line": {
      "sort": "901",
      "desc": "new line, html 빈줄",
      "insert": "<br/>"
    },
    "link card": {
      "sort": "100",
      "desc": "링크 카드",
      "insert": "{% linkcard ${1:링크} %}"
    },
    "toggle notion": {
      "sort": "101",
      "desc": "노션 스타일의 토글",
      "insert": "{% capture body1 %}\n${1:내용}\n{% endcapture %}\n{% include my/notion-toggle.html\ntitle=\"${2:제목}\"\nlevel=1\ncontent=body1\nopen=true\n%}"
    },
    "inline math": {
      "sort": "102",
      "desc": "내가 만든 수학 블럭",
      "insert": "{% math \"${1:내용}\" inline=true %}"
    }
  }
}
